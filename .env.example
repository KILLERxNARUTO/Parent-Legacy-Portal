# ──────────────────────────────────────────────────────────────────
#  Edutainal Student Progress Portal — Environment Configuration
#  Copy this file to .env and fill in the values before first run.
#  .env is git-ignored and must NEVER be committed.
# ──────────────────────────────────────────────────────────────────

# ── Server mode ───────────────────────────────────────────────────
# Set to 'production' to:
#   - Disable the /api/v1/auth/demo-login endpoint
#   - Require HTTPS secure cookies (also set PORTAL_SECURE_COOKIES=1)
# Leave blank or set to 'development' for local dev.
PORTAL_MODE=development

# ── Database path (Local SQLite) ──────────────────────────────────
# Default: backend/portal-secure.sqlite3 (relative to project root)
# Override with an absolute path for production deployments.
PORTAL_DB=backend/portal-secure.sqlite3

# ── Secure cookies (HTTPS deployments only) ───────────────────────
# Set to 1 when running behind HTTPS. Keeps cookies from being sent
# over plain HTTP. MUST be 1 in production.
PORTAL_SECURE_COOKIES=0

# ── Supabase Cloud Database & Auth Configuration ──────────────────
# Found in: Supabase Dashboard -> Project Settings -> API & Database
# SUPABASE_URL: Project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=

# SUPABASE_ANON_KEY: Client/browser anon key (safe for public/frontend realtime)
SUPABASE_ANON_KEY=

# SUPABASE_SERVICE_ROLE_KEY: Backend elevated service role key (bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=

# Optional Direct PostgreSQL Connection URI:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-ID].supabase.co:5432/postgres
